# SkillScreen Configuration File Example
# Copy this file to .config and fill in your actual values
# DO NOT commit the .config file to version control

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
WOLFRAM_APP_ID=your_wolfram_app_id_here
SERPAPI_KEY=your_serpapi_key_here

# Database Configuration
DATABASE_URL=sqlite:///./skillscreen.db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=skillscreen
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=your_secret_key_here

# External Services
SONAR_TOKEN=your_sonar_token_here
CODECOV_TOKEN=your_codecov_token_here

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIRECTORY=uploads/
ALLOWED_EXTENSIONS=pdf,docx,txt

# Security Configuration
CORS_ORIGINS=*
JWT_SECRET_KEY=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
