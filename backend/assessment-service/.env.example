# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/skillscreen

# Service Configuration
SERVICE_NAME=assessment-service
SERVICE_PORT=8005
ENVIRONMENT=development

# Assessment Scheduler Configuration
ASSESSMENT_CHECK_INTERVAL_MINUTES=10
ASSESSMENT_GRACE_PERIOD_MINUTES=5

# LLM Configuration (Groq API - FREE)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
# Alternative models:
# llama-3.1-8b-instant (faster, less accurate)
# llama-3.1-70b-versatile (slower, more accurate) - RECOMMENDED
# mixtral-8x7b-32768 (good balance)
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3
USE_LLM_WEIGHTS=false  # Enable/disable LLM weight determination

# Default Scoring Weights (if not provided via API)
DEFAULT_WEIGHT_CODING=0.40
DEFAULT_WEIGHT_TEXT=0.20
DEFAULT_WEIGHT_AUDIO=0.20
DEFAULT_WEIGHT_VIDEO=0.20

# Default Weights (No Coding)
DEFAULT_WEIGHT_TEXT_NO_CODING=0.34
DEFAULT_WEIGHT_AUDIO_NO_CODING=0.33
DEFAULT_WEIGHT_VIDEO_NO_CODING=0.33

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Health Check
HEALTH_CHECK_TIMEOUT_SECONDS=30